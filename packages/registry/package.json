{
  "name": "@repo/registry",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
  }
},
  "scripts": {
    "build": "bun build src/index.ts --format esm --dts --clean",
    "dev": "bun run src/index.ts --format esm --dts --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
