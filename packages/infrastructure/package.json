{
  "name": "@repo/infrastructure",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./db": {
      "types": "./src/storage/database/db.ts",
      "import": "./src/storage/database/db.ts"
    },
    "./blob": {
      "types": "./src/storage/blob/client.ts",
      "import": "./src/storage/blob/client.ts"
    },
    "./registry": {
      "types": "./src/storage/registry/index.ts",
      "import": "./src/storage/registry/index.ts"
    },
    "./network": {
      "types": "./src/network/index.ts",
      "import": "./src/network/index.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --format esm --dts --clean",
    "dev": "bun run src/index.ts --format esm --dts --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@repo/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
