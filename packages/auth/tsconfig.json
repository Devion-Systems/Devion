{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "esModuleInterop": true,
    "noEmit": true,
    "composite": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@devion/env/server": ["../env"]
    }
  },
  "include": ["src/**/*.ts", "index.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
