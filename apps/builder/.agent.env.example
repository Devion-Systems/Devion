FIRECRACKER_AGENT_HOST=127.0.0.1
FIRECRACKER_AGENT_PORT=3020
FIRECRACKER_AGENT_TOKEN=replace-with-at-least-24-random-characters
FIRECRACKER_BINARY_PATH=/usr/bin/firecracker
FIRECRACKER_KERNEL_PATH=/opt/firecracker/vmlinux
FIRECRACKER_SOCKET_DIR=/run/devion-builder/firecracker
FIRECRACKER_ROOTFS_DIR=/var/lib/devion-builder/rootfs
FIRECRACKER_IMAGE_DIR=/var/lib/devion-builder/images
FIRECRACKER_TAP_BRIDGE=br0
FIRECRACKER_ALLOWED_REGISTRIES=registry.example.internal
FIRECRACKER_BOOT_ARGS=console=ttyS0 reboot=k panic=1 pci=off
FIRECRACKER_GUEST_IP_PREFIX=172.20.0
FIRECRACKER_GUEST_GATEWAY=172.20.0.1
FIRECRACKER_STATE_DIR=/var/lib/devion-builder/state
FIRECRACKER_SETTINGS_FILE=/etc/devion-builder/hosting-settings.json
# This directory must be mounted read-only at /etc/traefik/dynamic.
TRAEFIK_DYNAMIC_CONFIG_DIR=/opt/devion/traefik/dynamic
TRAEFIK_BASE_DOMAIN=apps.example.com
TRAEFIK_CERT_RESOLVER=le-kunden
