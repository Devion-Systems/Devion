{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "esModuleInterop": true,
    "noEmit": true, 
    "composite": true,
    "outDir": "dist",
    "paths": {
       "@/*": ["./src/*"],
       "@devion/env/server":["../env"]
    }
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"]
}