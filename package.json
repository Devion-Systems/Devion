{
  "name": "devion",
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/bun": "^1.3.14",
    "turbo": "^2.8.21",
    "typescript": "5.9.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "builder:build": "bun run --cwd apps/builder build",
    "builder:test": "bun run --cwd apps/builder test",
    "builder:typecheck": "bun run --cwd apps/builder check-types",
    "builder:dev": "bun run --cwd apps/builder dev:api",
    "builder:worker": "bun run --cwd apps/builder dev:worker",
    "builder:agent": "bun run --cwd apps/builder dev:agent",
    "builder:up": "docker compose -f apps/builder/docker-compose.yml up --build -d",
    "builder:down": "docker compose -f apps/builder/docker-compose.yml down"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
