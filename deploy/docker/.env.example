POSTGRES_DB=devion
POSTGRES_USER=devion
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://devion:replace-with-a-long-random-password@postgres:5432/devion

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# The default control plane is accessed by the host IP. A custom domain is
# configured later in the dashboard and receives TLS after DNS verification.
HOST_IP=127.0.0.1
BETTER_AUTH_URL=http://127.0.0.1
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1
DASHBOARD_URL=http://127.0.0.1
PUBLIC_API_URL=http://127.0.0.1
# Optional enterprise OIDC / SSO provider. The callback URL is
# ${BETTER_AUTH_URL}/api/auth/callback/oidc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Generic OAuth / OIDC customization. All three values above must be set
# together. Set OIDC_ALLOW_SIGN_UP=true only when new IdP users may be
# provisioned automatically. Domains are comma-separated, e.g. example.com.
OIDC_PROVIDER_ID=oidc
OIDC_PROVIDER_NAME=Company SSO
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_ALLOW_SIGN_UP=false
OIDC_PROMPT=
NEXT_PUBLIC_OIDC_ENABLED=false
# Checks new and changed passwords against the HIBP Pwned Passwords API.
# Keep enabled in production; turn off only for controlled offline development.
HIBP_ENABLED=true
# Address reachable from pgAdmin clients. Set this to your server IP or DNS name.
DATABASE_PUBLIC_HOST=127.0.0.1
BETTER_AUTH_COOKIE_DOMAIN=

S3_ACCESS_KEY=devion-storage
S3_SECRET_KEY=replace-with-a-long-random-password
S3_ENDPOINT=http://rustfs:9000
DOCKER_REGISTRY_URL=http://registry:5000
REGISTRY_PORT=5000
BUILDER_API_TOKEN=replace-with-at-least-24-random-characters
BUILDER_WORKER_CONCURRENCY=2
# Runtime-visible registry prefix. Use a TLS hostname reachable by every node
# before enabling remote-node Git deployments.
DEVION_BUILD_IMAGE_PREFIX=localhost:5000/devion

TRAEFIK_ENABLED=true
TRAEFIK_DYNAMIC_CONFIG_DIR=/data/traefik/dynamic
TRAEFIK_CERTS_DIR=/data/traefik/certs
TRAEFIK_CERTS_TRAEFIK_DIR=/etc/traefik/certs
TRAEFIK_INTERNAL_DOMAIN=
TRAEFIK_PUBLIC_IP=127.0.0.1
# Required before activating a custom domain with Let's Encrypt.
TRAEFIK_ACME_EMAIL=
TRAEFIK_PROJECT_UPSTREAM_TEMPLATE=http://devion-project-{projectSlug}:3000
# TRAEFIK_CNAME_TARGET=proxy.example.com
TRAEFIK_CNAME_TARGET=
HTTP_PORT=80
HTTPS_PORT=443
