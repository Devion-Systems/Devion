POSTGRES_DB=devion
POSTGRES_USER=devion
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://devion:replace-with-a-long-random-password@postgres:5432/devion

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# `.test` is reserved for local testing and avoids macOS Bonjour's `.local`
# name resolution. HTTP is intentional for the initial local installation.
BETTER_AUTH_URL=http://api.devion.test
BETTER_AUTH_TRUSTED_ORIGINS=http://dashboard.devion.test
BETTER_AUTH_COOKIE_DOMAIN=devion.test
DASHBOARD_URL=http://dashboard.devion.test
API_HOST=api.devion.test
DASHBOARD_HOST=dashboard.devion.test
PUBLIC_API_URL=http://api.devion.test

S3_ACCESS_KEY=devion-storage
S3_SECRET_KEY=replace-with-a-long-random-password
S3_ENDPOINT=http://rustfs:9000
DOCKER_REGISTRY_URL=http://registry:5000

TRAEFIK_ENABLED=true
TRAEFIK_DYNAMIC_CONFIG_DIR=/data/traefik/dynamic
TRAEFIK_CERTS_DIR=/data/traefik/certs
TRAEFIK_CERTS_TRAEFIK_DIR=/etc/traefik/certs
TRAEFIK_INTERNAL_DOMAIN=devion.test
TRAEFIK_PROJECT_UPSTREAM_TEMPLATE=http://devion-project-{projectSlug}:3000
TRAEFIK_CNAME_TARGET=proxy.devion.test
HTTP_PORT=80
HTTPS_PORT=443
