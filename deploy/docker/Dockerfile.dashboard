FROM oven/bun:1.3.14-alpine AS dependencies
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/package.json
COPY apps/agent/package.json apps/agent/package.json
COPY apps/builder/package.json apps/builder/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/registry/package.json packages/registry/package.json
COPY packages/s3/package.json packages/s3/package.json
RUN bun install --frozen-lockfile

FROM dependencies AS build
WORKDIR /app
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_OIDC_ENABLED=false
ARG NEXT_PUBLIC_OIDC_PROVIDER_ID=oidc
ARG NEXT_PUBLIC_OIDC_PROVIDER_NAME="Company SSO"
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_OIDC_ENABLED=$NEXT_PUBLIC_OIDC_ENABLED
ENV NEXT_PUBLIC_OIDC_PROVIDER_ID=$NEXT_PUBLIC_OIDC_PROVIDER_ID
ENV NEXT_PUBLIC_OIDC_PROVIDER_NAME=$NEXT_PUBLIC_OIDC_PROVIDER_NAME
RUN bun run --cwd apps/dashboard build

FROM oven/bun:1.3.14-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/dashboard ./apps/dashboard
EXPOSE 3000
CMD ["bun", "run", "--cwd", "apps/dashboard", "start"]
